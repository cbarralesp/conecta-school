<app-teacher-modern-layout
  title=""
  activeItem="planning"
  dashboardRoute="/dashboard"
  [userName]="user()?.nombre ?? 'Docente'"
  userRole="Docente">
  <main class="content-area">
    @if (isLoading()) {
      <section class="loading-card">
        <mat-icon>hourglass_top</mat-icon>
        <strong>Cargando catalogos para la nueva planificacion...</strong>
      </section>
    } @else {
      <form class="planner-container" [formGroup]="form">
        <div class="planner-header">
          <div class="planner-title">
            <h2>{{ pageTitle() }}</h2>
            <p>{{ plannerSubtitle() }}</p>
          </div>
          <div class="meta-badges">
            <div class="badge">
              <mat-icon>schedule</mat-icon>
              {{ selectedDurationLabel() }}
            </div>
            <div class="badge">
              <mat-icon>event</mat-icon>
              {{ plannedDateLabel() }}
            </div>
          </div>
        </div>

        <div class="data-bar">
          <div class="data-row">
            <div class="input-group">
              <label class="data-label" for="planning-title">Titulo de la clase</label>
              <div class="data-input-shell data-input-shell--text">
                <mat-icon>edit_note</mat-icon>
                <input
                  id="planning-title"
                  type="text"
                  class="data-input"
                  formControlName="title"
                  placeholder="Ej: Mezcla de colores primarios">
              </div>
            </div>

            <div class="input-group">
              <label class="data-label" for="planning-subject">Asignatura</label>
              <div class="data-input-shell">
                <mat-icon>menu_book</mat-icon>
                <select
                  id="planning-subject"
                  class="data-input"
                  formControlName="subjectId"
                  (change)="updateSubject($any($event.target).value)">
                  @for (subject of subjectOptions(); track subject.id) {
                    <option [value]="subject.id">{{ subject.name }}</option>
                  }
                </select>
              </div>
            </div>

            <div class="input-group">
              <label class="data-label" for="planning-grade">Nivel</label>
              <div class="data-input-shell">
                <mat-icon>school</mat-icon>
                <select
                  id="planning-grade"
                  class="data-input"
                  formControlName="courseId"
                  (change)="updateCourse($any($event.target).value)">
                  @for (course of courseOptions(); track course.id) {
                    <option [value]="course.id">{{ course.name }}</option>
                  }
                </select>
              </div>
            </div>

            <div class="input-group">
              <label class="data-label" for="planning-unit">Unidad</label>
              <div class="data-input-shell">
                <mat-icon>layers</mat-icon>
                <select
                  id="planning-unit"
                  class="data-input"
                  formControlName="unitId"
                  (change)="updateUnit($any($event.target).value)">
                  @for (unit of filteredUnits(); track unit.unitId) {
                    <option [value]="unit.unitId">{{ unit.unitNumberLabel }} - {{ unit.unitName }}</option>
                  }
                </select>
              </div>
            </div>

            <div class="input-group">
              <label class="data-label" for="planning-date">Fecha</label>
              <div class="data-input-shell">
                <mat-icon>calendar_month</mat-icon>
                <input
                  id="planning-date"
                  type="date"
                  class="data-input"
                  [value]="plannedDateInputValue()"
                  (change)="updatePlannedDate($any($event.target).value)">
              </div>
            </div>
          </div>
        </div>

        <section class="curriculum-selector-card">
          <div class="curriculum-selector-header">
            <div>
              <span class="curriculum-selector-eyebrow">Alineacion oficial</span>
              <h3>Objetivos de Aprendizaje oficiales</h3>
              <p>Selecciona multiples OA del Mineduc sin reemplazar los objetivos actuales de la planificacion.</p>
            </div>
          </div>

          <div class="curriculum-filter-grid">
            <div class="curriculum-filter-group">
              <label class="data-label" for="curriculum-subject">Asignatura oficial</label>
              <div class="data-input-shell">
                <mat-icon>menu_book</mat-icon>
                <select
                  id="curriculum-subject"
                  class="data-input"
                  [value]="selectedCurriculumSubjectId() ?? ''"
                  (change)="selectCurriculumSubject($any($event.target).value)">
                  <option value="">Seleccione asignatura...</option>
                  @for (subject of curriculumSubjects(); track subject.id) {
                    <option [value]="subject.id">{{ subject.nombre }}</option>
                  }
                </select>
              </div>
            </div>

            <div class="curriculum-filter-group">
              <label class="data-label" for="curriculum-grade">Grado oficial</label>
              <div class="data-input-shell">
                <mat-icon>school</mat-icon>
                <select
                  id="curriculum-grade"
                  class="data-input"
                  [value]="selectedCurriculumGradeId() ?? ''"
                  (change)="selectCurriculumGrade($any($event.target).value)">
                  <option value="">Seleccione grado...</option>
                  @for (grade of curriculumGrades(); track grade.id) {
                    <option [value]="grade.id">{{ grade.label }}</option>
                  }
                </select>
              </div>
            </div>

            <div class="curriculum-filter-group">
              <label class="data-label" for="curriculum-axis">Eje</label>
              <div class="data-input-shell">
                <mat-icon>category</mat-icon>
                <select
                  id="curriculum-axis"
                  class="data-input"
                  [value]="selectedCurriculumAxis()"
                  (change)="updateCurriculumAxis($any($event.target).value)">
                  <option value="all">Todos los ejes</option>
                  @for (axis of curriculumAxisOptions(); track axis) {
                    <option [value]="axis">{{ axis }}</option>
                  }
                </select>
              </div>
            </div>

            <div class="curriculum-filter-group">
              <label class="data-label" for="curriculum-type">Tipo</label>
              <div class="data-input-shell">
                <mat-icon>tune</mat-icon>
                <select
                  id="curriculum-type"
                  class="data-input"
                  [value]="selectedCurriculumType()"
                  (change)="updateCurriculumType($any($event.target).value)">
                  <option value="all">Todos los tipos</option>
                  <option value="conocimiento">Conocimiento</option>
                  <option value="habilidad">Habilidad</option>
                </select>
              </div>
            </div>
          </div>

          @if (selectedCurriculumObjectives().length > 0) {
            <div class="curriculum-selected">
              <span class="curriculum-selected__label">OA seleccionados</span>
              <div class="curriculum-chip-list">
                @for (objective of selectedCurriculumObjectives(); track objective.id) {
                  <button class="curriculum-chip" type="button" (click)="removeCurriculumObjective(objective.id)">
                    <span class="curriculum-chip__code">{{ objective.codigo }}</span>
                    <span class="curriculum-chip__text">{{ objective.descripcion }}</span>
                    <mat-icon>close</mat-icon>
                  </button>
                }
              </div>
            </div>
          }

          <div class="curriculum-objective-list">
            @if (isCurriculumLoading()) {
              <div class="curriculum-empty-state">
                <mat-icon>hourglass_top</mat-icon>
                <span>Cargando OA oficiales...</span>
              </div>
            } @else if (filteredCurriculumObjectives().length === 0) {
              <div class="curriculum-empty-state">
                <mat-icon>rule</mat-icon>
                <span>No hay OA oficiales para los filtros seleccionados.</span>
              </div>
            } @else {
              @for (objective of filteredCurriculumObjectives(); track objective.id) {
                <label class="curriculum-objective-row">
                  <input
                    type="checkbox"
                    [checked]="isCurriculumObjectiveSelected(objective.id)"
                    (change)="toggleCurriculumObjective(objective)">
                  <div class="curriculum-objective-content">
                    <div class="curriculum-objective-meta">
                      <span class="curriculum-objective-code">{{ objective.codigo }}</span>
                      <span class="curriculum-objective-type">{{ objective.tipo }}</span>
                    </div>
                    <div class="curriculum-objective-axis">{{ objective.eje }}</div>
                    <div class="curriculum-objective-description">{{ objective.descripcion }}</div>
                    @if (objective.subItems.length > 0) {
                      <details class="curriculum-subitems">
                        <summary>Ver subitems</summary>
                        <ul>
                          @for (item of objective.subItems; track item) {
                            <li>{{ item }}</li>
                          }
                        </ul>
                      </details>
                    }
                  </div>
                </label>
              }
            }
          </div>
        </section>

        <div class="planner-grid">
          <div class="planner-main">
            <div class="section-title">
              <mat-icon>layers</mat-icon>
              Estructura de la Clase
            </div>

            <div class="phase-card">
              <div class="phase-header">
                <div class="phase-name">
                  <div class="icon-inicio">
                    <mat-icon>play_arrow</mat-icon>
                  </div>
                  Inicio
                </div>
                <input type="text" class="time-input" value="15 min" readonly>
              </div>
              <div class="phase-support">
                <label class="micro-label" for="planning-start-strategy">Estrategia Pedagogica</label>
                <select
                  id="planning-start-strategy"
                  class="mini-select"
                  [value]="startStrategy()"
                  (change)="setStartStrategy($any($event.target).value)">
                  @for (strategy of startStrategyOptions; track strategy) {
                    <option [value]="strategy">{{ strategy }}</option>
                  }
                </select>
              </div>
              <textarea
                class="rich-editor-placeholder"
                formControlName="startActivity"
                placeholder="Activacion de conocimientos previos..."></textarea>
            </div>

            <div class="phase-card">
              <div class="phase-header">
                <div class="phase-name">
                  <div class="icon-desarrollo">
                    <mat-icon>design_services</mat-icon>
                  </div>
                  Desarrollo
                </div>
                <input type="text" class="time-input" value="60 min" readonly>
              </div>
              <div class="phase-support">
                <label class="micro-label" for="planning-grouping">Organizacion / Agrupacion</label>
                <select
                  id="planning-grouping"
                  class="mini-select"
                  [value]="groupingMode()"
                  (change)="setGroupingMode($any($event.target).value)">
                  @for (grouping of groupingOptions; track grouping) {
                    <option [value]="grouping">{{ grouping }}</option>
                  }
                </select>
              </div>
              <textarea
                class="rich-editor-placeholder"
                formControlName="developmentActivity"
                placeholder="Instrucciones de la actividad principal..."></textarea>
              <div class="phase-note">
                <strong>
                  <mat-icon>info</mat-icon>
                  Nota:
                </strong>
                Considerar adaptacion para estudiantes con dificultad motora fina (uso de materiales tridimensionales).
              </div>
            </div>

            <div class="phase-card">
              <div class="phase-header">
                <div class="phase-name">
                  <div class="icon-cierre">
                    <mat-icon>flag</mat-icon>
                  </div>
                  Cierre
                </div>
                <input type="text" class="time-input" value="15 min" readonly>
              </div>
              <textarea
                class="rich-editor-placeholder"
                formControlName="closingActivity"
                placeholder="Metacognicion y sintesis..."></textarea>
            </div>

            <div class="phase-card reflection-card">
              <div class="phase-header phase-header--soft">
                <div class="phase-name phase-name--reflection">
                  <mat-icon>sticky_note_2</mat-icon>
                  Reflexion Docente (Post-clase)
                </div>
              </div>

              <div class="reflection-grid">
                <div class="reflection-field">
                  <label class="micro-label" for="planning-reflection-success">Que funciono bien?</label>
                  <textarea
                    id="planning-reflection-success"
                    class="reflection-input"
                    rows="2"
                    [value]="reflectionSuccess()"
                    (input)="updateReflectionSuccess($any($event.target).value)"
                    placeholder="Aspectos positivos..."></textarea>
                </div>

                <div class="reflection-field">
                  <label class="micro-label" for="planning-reflection-improve">Que mejorar?</label>
                  <textarea
                    id="planning-reflection-improve"
                    class="reflection-input"
                    rows="2"
                    [value]="reflectionImprove()"
                    (input)="updateReflectionImprove($any($event.target).value)"
                    placeholder="Aspectos a ajustar..."></textarea>
                </div>
              </div>

              <div class="achievement-row">
                <label class="achievement-label" for="planning-achievement">Logro estimado del OA:</label>
                <input
                  id="planning-achievement"
                  type="range"
                  min="0"
                  max="100"
                  [value]="objectiveAchievement()"
                  (input)="updateObjectiveAchievement($any($event.target).value)">
                <span class="achievement-value">{{ objectiveAchievement() }}%</span>
              </div>
            </div>
          </div>

          <div class="planner-sidebar">
            <div class="section-title">
              <mat-icon>link</mat-icon>
              Alineacion Mineduc
            </div>

            <div class="curriculum-box">
              <div class="curriculum-label">Objetivos de Aprendizaje (OA)</div>
              <select class="oa-select" formControlName="objectiveCode">
                <option value="">Seleccione OA...</option>
                @for (group of objectiveGroups(); track group.axis) {
                  <optgroup [label]="group.axis">
                    @for (objective of group.objectives; track objective.code) {
                      <option [value]="objective.code">
                        {{ objective.code }}: {{ objective.label }}
                      </option>
                    }
                  </optgroup>
                }
              </select>

              <div class="tags-container">
                @if (selectedObjective(); as objective) {
                  <span class="oa-tag">
                    {{ objective.code }}
                    <mat-icon>close</mat-icon>
                  </span>
                  @if (objective.axis) {
                    <p class="objective-axis">{{ objective.axis }}</p>
                  }
                  <p class="objective-description">{{ objective.description }}</p>
                }
              </div>

              <button class="add-oa-btn" type="button" (click)="addSelectedObjective()">
                <mat-icon>add_circle</mat-icon>
                Agregar OA Seleccionado
              </button>
            </div>

            <div class="curriculum-panel-card">
              <div class="curriculum-label">Habilidades (Transversales)</div>
              <div class="card-subsection">
                <span class="subsection-title">Habilidades (Bases Curriculares)</span>
                <div class="text-list">
                  @for (skill of displayedSkills(); track skill) {
                    <div class="text-list-item">{{ skill }}</div>
                  }
                  <button class="inline-add" type="button">+ Habilidad</button>
                </div>
              </div>

              @if (selectedObjective(); as objective) {
                <div class="card-divider"></div>
                <div class="card-subsection">
                  <span class="subsection-title">Ejes de las OAs trabajadas</span>
                  @if (objective.axis) {
                    <span class="badge-eje">{{ objective.axis }}</span>
                  }
                  @if (displayedSkills().length > 0) {
                    <span class="badge-hab">Habilidades: {{ displayedSkills()[0] }}</span>
                  }
                </div>
              }
            </div>

            <div class="curriculum-panel-card">
              <div class="curriculum-label">Actitudes Transversales</div>
              <div class="card-subsection">
                <span class="subsection-title">Actitudes</span>
                <div class="text-list">
                  @for (attitude of displayedAttitudes(); track attitude) {
                    <div class="text-list-item">{{ attitude }}</div>
                  }
                  <button class="inline-add" type="button">+ Actitud</button>
                </div>
              </div>
            </div>

            <div class="curriculum-panel-card">
              <div class="curriculum-label">Evaluacion</div>

              <div class="card-subsection">
                <span class="subsection-title">Tipo de evaluacion</span>
                <div class="chips-container">
                  @for (item of catalogs()?.evaluationTypes ?? []; track item.code) {
                    <button
                      class="chip"
                      type="button"
                      [class.chip--active]="isActiveEvaluationType(item.code)"
                      (click)="selectEvaluationType(item.code)">
                      {{ item.label }}
                    </button>
                  }
                </div>
              </div>

              <div class="card-subsection">
                <span class="subsection-title">Para el aprendizaje</span>
                <div class="chips-container">
                  @for (item of learningApproachOptions; track item) {
                    <button
                      class="chip"
                      type="button"
                      [class.chip--active]="isActiveLearningApproach(item)"
                      (click)="selectLearningApproach(item)">
                      {{ item }}
                    </button>
                  }
                </div>
              </div>

              <div class="card-subsection">
                <span class="subsection-title">Instrumento</span>
                <div class="chips-container chips-container--dense">
                  @for (item of instrumentOptions; track item) {
                    <button
                      class="chip"
                      type="button"
                      [class.chip--active]="isActiveInstrument(item)"
                      (click)="selectInstrument(item)">
                      {{ item }}
                    </button>
                  }
                </div>
              </div>
            </div>

            <div class="curriculum-panel-card">
              <div class="curriculum-label">Recursos y Diversidad</div>

              <div class="card-subsection">
                <span class="subsection-title">Recursos</span>
                <div class="chips-container chips-container--dense">
                  @for (resource of resourceOptions; track resource) {
                    <button
                      class="chip"
                      type="button"
                      [class.chip--active]="hasActiveResource(resource)"
                      (click)="toggleResource(resource)">
                      {{ resource }}
                    </button>
                  }
                </div>
              </div>

              <div class="card-divider"></div>

              <div class="card-subsection">
                <span class="subsection-title subsection-title--warning">Adaptaciones previstas</span>
                <div class="chips-container chips-container--dense">
                  @for (support of diversitySupportOptions; track support) {
                    <button
                      class="chip chip--warning"
                      type="button"
                      [class.chip--warning-active]="hasActiveDiversitySupport(support)"
                      (click)="toggleDiversitySupport(support)">
                      {{ support }}
                    </button>
                  }
                </div>

                <textarea
                  class="diversity-input"
                  rows="2"
                  [value]="diversityNotes()"
                  (input)="updateDiversityNotes($any($event.target).value)"
                  placeholder="Describe adaptaciones especificas..."></textarea>
              </div>
            </div>
          </div>
        </div>

        <div class="planner-footer">
          <button class="btn btn-ghost" type="button" (click)="cancel()">Cancelar</button>
          <button
            class="btn btn-primary"
            type="button"
            [disabled]="isSaving()"
            (click)="publishToStudents()">
            <mat-icon>save</mat-icon>
            {{ saveButtonLabel() }}
          </button>
        </div>
      </form>
    }
  </main>
</app-teacher-modern-layout>
